#PBS -N xHI_chain
#PBS -V 
#PBS -l select=1:ncpus=32:mem=512gb
#PBS -j oe


# 作业开始后，PBS 将在一个新工作目录运行，通常是 $PBS_O_WORKDIR
cd "$PBS_O_WORKDIR"

module load python3/3.11

python mcmc/extract_xhi_chains.py \
  --chains mcmc/long1.npz mcmc/long4.npz \
  --targets 5 95 \
  --nprocs 8 --chunk-size 256 \
  --out-dir mcmc --prefix xhi